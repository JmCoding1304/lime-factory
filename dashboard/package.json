{
  "name": "lime-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only observability UI for limefactory — polls every registered project's lime.db.",
  "scripts": {
    "dev": "vite",
    "server": "bun run server/index.ts",
    "dev:all": "bun run server/index.ts & vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "bun run server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test",
    "logos": "bun scripts/fetch-logos.ts",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/jsdom": "^30.0.0",
    "@vitejs/plugin-vue": "^6",
    "jsdom": "^31.0.0",
    "oxlint": "^1",
    "typescript": "^5.7.2",
    "vite": "^7.3.8",
    "vue-tsc": "^3"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
